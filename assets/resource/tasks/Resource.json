{
    "task": [
        {
            "name": "資源掃蕩",
            "entry": "Resource",
            "doc": "不足目標掃蕩次數會掃蕩到可掃蕩的最大值",
            "option": [
                "掃蕩資源",
                "掃蕩次數",
                "使用全部體力"
            ],
            "pipeline_override": {
                "EnterOpsHub": {
                    "next": "EnterDiscity"
                },
                "EnterDiscity": {
                    "next": "EnterTheRust"
                },
                "EnterTheRust": {
                    "next": [
                        "EnterResource",
                        "EnterTheRust"
                    ]
                }
            }
        }
    ],
    "option": {
        "掃蕩資源": {
            "type": "select",
            "cases": [
                {
                    "name": "狄斯幣",
                    "icon": "./icons/DisCoin.png",
                    "pipeline_override": {
                        "EnterResource": {
                            "expected": "清剿"
                        },
                        "EnterResourceItem": {
                            "expected": "淘金"
                        },
                        "VerifyResourceItem": {
                            "expected": "淘金"
                        },
                        "EnterResourceLevel": {
                            "expected": "5",
                            "roi": [1177, 472, 16, 22]
                        }
                    }
                },
                {
                    "name": "狂亂精粹",
                    "icon": "./icons/ManiaEssence.png",
                    "pipeline_override": {
